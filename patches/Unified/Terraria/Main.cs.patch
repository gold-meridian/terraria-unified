+						new Rectangle(0, 0, (x - runStart) << 4, 16),
+						Color.Black
+					);
+					runStart = -1;
+				}
+			}
+
+			if (runStart >= 0) {
+				spriteBatch.Draw(
+					TextureAssets.BlackTile.Value,
+					new Vector2(runStart << 4, y << 4) - screenPosition + drawOffset,
+					new Rectangle(0, 0, (endX - runStart) << 4, 16),
+					Color.Black
+				);
+			}
+		}
+	}
