+	[MethodImpl(MethodImplOptions.AggressiveInlining)]
+	private static int GetBlackMaskIndex(int x, int y)
+	{
+		return y * blackMaskWidth + x;
+	}
+
+	private static void BuildLightingBrightnessCache(int startX, int endX, int startY, int endY)
+	{
+		/*
+		for (int y = startY; y < endY; y++) {
+			for (int x = startX; x < endX; x++) {
+				lightingCache[GetBlackMaskIndex(x, y)] = (byte)MathF.Floor(Lighting.Brightness(x, y) * 255f);
+			}
+		}
+		*/
+
+		Parallel.For(startX, endX, x => {
+			for (int y = startY; y < endY; y++) {
+				lightingCache[GetBlackMaskIndex(x - startX, y - startY)] = (byte)Math.Clamp(MathF.Floor(Lighting.Brightness(x, y) * 255f), 0, 255);
+			}
+		});
+	}
+
+	private const byte underworld_threshold = (byte)(0.2f * 255f);
+
+	private static void BuildBlackMask(int startX, int endX, int startY, int endY, byte baseThreshold, bool force)
+	{
+		bool showInvisible = ShouldShowInvisibleBlocksAndWalls();
+		bool liquidSlopeFix = LiquidEdgeRenderer.Active;
+
+		Parallel.For(startY, endY, y => {
+			bool underworld = y >= UnderworldLayer;
+			byte threshold = underworld ? underworld_threshold : baseThreshold;
+
+			for (int x = startX; x < endX; x++) {
+				var idx = GetBlackMaskIndex(x - startX, y - startY);
+
+				/*
+				if (!WorldGen.InWorld(x, y)) {
+					blackMask[idx] = 0;
+					continue;
+				}
+				*/
+
+				var t = tile[x, y];
+				byte brightness = lightingCache[idx];
+
+				bool hasFullWater = LiquidRenderer.Instance.HasFullWater(x, y);
+				if (liquidSlopeFix && hasFullWater && ((t.Slope != SlopeType.Solid || t.IsHalfBlock) ? brightness >= 5 : brightness > 5)) {
+					blackMask[idx] = 0;
+					continue;
+				}
+
+				byte liquid = t.LiquidAmount;
+				bool darkEnough = brightness <= threshold && ((!underworld && liquid < 250) || WorldGen.SolidTile(t) || (liquid >= 200 && brightness == 0));
+				if (!darkEnough) {
+					blackMask[idx] = 0;
+					continue;
+				}
+
+				bool blocksLight = t.HasTile && tileBlockLight[t.TileType] && (!t.IsTileInvisible || showInvisible);
+				bool wallBlocks = !WallID.Sets.Transparent[t.WallType] && (!t.IsWallInvisible || showInvisible);
+				if (!blocksLight && !wallBlocks) {
+					blackMask[idx] = 0;
+					continue;
+				}
+
+				if (!drawToScreen && hasFullWater && t.WallType == 0 && !t.IsHalfBlock && y <= worldSurface) {
+					blackMask[idx] = 0;
+					continue;
+				}
+
+				blackMask[idx] = 1;
+			}
+		});
+	}
+
+	private static void DrawBlackMask(int startX, int endX, int startY, int endY, Vector2 drawOffset)
+	{
+		for (int y = startY; y < endY; y++) {
+			int runStart = -1;
+
+			for (int x = startX; x < endX; x++) {
+				bool black = blackMask[GetBlackMaskIndex(x - startX, y - startY)] != 0;
+
+				if (black) {
+					if (runStart < 0) {
+						runStart = x;
+					}
+				}
+				else if (runStart >= 0) {
+					spriteBatch.Draw(
+						TextureAssets.BlackTile.Value,
