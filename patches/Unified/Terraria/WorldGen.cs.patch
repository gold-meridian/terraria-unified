+	public static void SetWorldSize(WorldSize size)
+	{
+		// Super Small/Large are not generatable so give them sane defaults.
+		// They are labels for sizes that don't fit our pre-generated options,
+		// and this API won't ever be called on them.
+		switch (size) {
+			case WorldSize.SuperSmall:
+			case WorldSize.ExtraSmall:
+				SetWorldSize(WorldSizeExtraSmallX, WorldSizeExtraSmallY);
+				break;
+
+			case WorldSize.Small:
+				SetWorldSize(WorldSizeSmallX, WorldSizeSmallY);
+				break;
+
+			case WorldSize.Medium:
+				SetWorldSize(WorldSizeMediumX, WorldSizeMediumY);
+				break;
+
+			case WorldSize.Large:
+				SetWorldSize(WorldSizeLargeX, WorldSizeLargeY);
+				break;
+
+			case WorldSize.ExtraLarge:
+			case WorldSize.SuperLarge:
+				SetWorldSize(WorldSizeExtraLargeX, WorldSizeExtraLargeY);
+				break;
+		}
+	}
