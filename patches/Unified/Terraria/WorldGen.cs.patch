+	public static WorldSize GetWorldSize()
+	{
+		return GetWorldSize(Main.maxTilesX);
+	}
+
+	public static WorldSize GetWorldSize(int maxTilesX)
+	{
+		// Ridiculous edge case but it's better to display Super Small than
+		// Super Large for such case.
+		if (maxTilesX <= 0) {
+			return WorldSize.SuperSmall;
+		}
+
+		if (maxTilesX < WorldSizeExtraSmallX) {
+			return WorldSize.SuperSmall;
+		}
+
+		if (maxTilesX == WorldSizeExtraSmallX) {
+			return WorldSize.ExtraSmall;
+		}
+
+		if (maxTilesX <= WorldSizeSmallX) {
+			return WorldSize.Small;
+		}
+
+		if (maxTilesX <= WorldSizeMediumX) {
+			return WorldSize.Medium;
+		}
+
+		if (maxTilesX <= WorldSizeLargeX) {
+			return WorldSize.Large;
+		}
+
+		if (maxTilesX <= WorldSizeExtraLargeX) {
+			return WorldSize.ExtraLarge;
+		}
+
+		return WorldSize.SuperLarge;
+	}
